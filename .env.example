# Copy to .env.local (Next) / export for the API. Never commit real values.

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Upstash Redis REST database; without these the API falls back to an in-memory store (tests, local smoke)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JAMINAN_KEY_PREFIX=jaminan:

# Vision model (Qwen via DashScope, OpenAI-compatible)
QWEN_API_KEY=
JAMINAN_VISION_MODEL=qwen3-vl-plus
# Left empty until the benchmark pins a model: with no pinned model no claim is ever chargeable
JAMINAN_BENCHMARKED_MODEL=
JAMINAN_CONFIDENCE_FLOOR=0.7

# Public base URL (used in QR links and PayPal return URLs)
APP_URL=http://localhost:3000

# /judge route: sandbox wallets pool and the sandbox buyer shown for the "full path" button
JUDGE_VAULT_IDS=
JUDGE_BUYER_EMAIL=
JUDGE_BUYER_PASSWORD=

# Bearer secret for the daily Vercel Cron call
CRON_SECRET=
